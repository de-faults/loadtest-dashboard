# HTTP port for the dashboard
DASHBOARD_PORT=4300

# Bind address. Off-loopback binds REFUSE to start unless DASHBOARD_TOKEN is set:
# this service spawns load generators, so an open bind is a remote-exec surface.
DASHBOARD_BIND=127.0.0.1

# Shared token. Required for any non-loopback bind. Sent as x-dashboard-token.
# DASHBOARD_TOKEN=

# SQLite database + WAL live here
DASHBOARD_DATA_DIR=./data

# Concurrent runs. Keep at 1 — parallel runs skew each other's numbers.
DASHBOARD_MAX_RUNS=1
